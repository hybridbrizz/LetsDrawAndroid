<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingHorizontal="40dp"
        android:background="#000"
        android:clipChildren="false"
        android:clipToPadding="false">

    <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

    <com.matrixwarez.pt.colorpicker.RGBColorWheel
            android:id="@+id/rgb_color_wheel"
            android:layout_width="240dp"
            android:layout_height="240dp">

        <com.matrixwarez.pt.colorpicker.SBIndicator
                android:id="@+id/sb_indicator"
                android:layout_width="20dp"
                android:layout_height="20dp" />

    </com.matrixwarez.pt.colorpicker.RGBColorWheel>

    <com.matrixwarez.pt.colorpicker.HPalette
            android:id="@+id/h_palette"
            android:layout_width="match_parent"
            android:layout_height="20dp"
            android:layout_marginTop="20dp">

        <com.matrixwarez.pt.colorpicker.SBIndicator
                android:id="@+id/h_indicator"
                android:layout_width="20dp"
                android:layout_height="20dp" />

    </com.matrixwarez.pt.colorpicker.HPalette>

    <com.matrixwarez.pt.colorpicker.SPalette
            android:id="@+id/s_palette"
            android:layout_width="match_parent"
            android:layout_height="20dp"
            android:layout_marginTop="20dp">

        <com.matrixwarez.pt.colorpicker.SBIndicator
                android:id="@+id/s_indicator"
                android:layout_width="20dp"
                android:layout_height="20dp" />

    </com.matrixwarez.pt.colorpicker.SPalette>

    <com.matrixwarez.pt.colorpicker.BPalette
            android:id="@+id/b_palette"
            android:layout_width="match_parent"
            android:layout_height="20dp"
            android:layout_marginTop="20dp">

        <com.matrixwarez.pt.colorpicker.SBIndicator
                android:id="@+id/b_indicator"
                android:layout_width="20dp"
                android:layout_height="20dp" />

    </com.matrixwarez.pt.colorpicker.BPalette>

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:paddingTop="20dp"
            android:paddingBottom="40dp">

        <Button
                android:id="@+id/cancel_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Cancel"
                android:textColor="#FFF"
                android:backgroundTint="#232323" />

        <View
                android:layout_width="20dp"
                android:layout_height="0dp" />

        <Button
                android:id="@+id/ok_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="OK"
                android:textColor="#FFF"
                android:backgroundTint="#232323" />

    </LinearLayout>

</LinearLayout>