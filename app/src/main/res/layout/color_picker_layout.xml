<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center">

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            app:layout_constraintTop_toBottomOf="@id/color_picker_action_layout"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

        <com.matrixwarez.pt.colorpicker.SBPalette
                android:id="@+id/sb_palette"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

        <com.matrixwarez.pt.colorpicker.HPalette
                android:id="@+id/h_palette"
                android:layout_width="match_parent"
                android:layout_height="40dp" />

    </LinearLayout>

    <com.matrixwarez.pt.colorpicker.SBIndicator
            android:id="@+id/sb_indicator"
            android:layout_width="20dp"
            android:layout_height="20dp" />

    <com.matrixwarez.pt.colorpicker.HIndicator
            android:id="@+id/h_indicator"
            android:layout_width="2dp"
            android:layout_height="40dp" />
</FrameLayout>