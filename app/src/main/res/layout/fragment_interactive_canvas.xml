                    android:background="@android:color/black"
                    android:layout_gravity="center" />

            <com.matrixwarez.pt.view.DeviceCanvasViewportView
                    android:id="@+id/device_canvas_viewport_view"
                    android:layout_width="180dp"
                    android:layout_height="180dp"
                    android:layout_gravity="center" />

            <androidx.compose.ui.platform.ComposeView
                    android:id="@+id/canvas_summary_clients_view"
                    android:layout_width="180dp"
                    android:layout_height="180dp" />

        </FrameLayout>

        <com.matrixwarez.pt.view.ActionButtonFrame
                android:id="@+id/object_move_up_button"
                android:visibility="gone"
                android:layout_width="100dp"
                android:layout_height="100dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

            <com.matrixwarez.pt.view.ActionButtonView
                    android:id="@+id/object_move_up_action"
                    android:layout_width="15dp"
                    android:layout_height="5dp"
                    android:layout_gravity="bottom|center_horizontal" />

        </com.matrixwarez.pt.view.ActionButtonFrame>

        <com.matrixwarez.pt.view.ActionButtonFrame
                android:id="@+id/object_move_down_button"
                android:visibility="gone"
                android:layout_width="100dp"
                android:layout_height="100dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

            <com.matrixwarez.pt.view.ActionButtonView
                    android:id="@+id/object_move_down_action"
                    android:layout_width="15dp"
                    android:layout_height="5dp"
                    android:layout_gravity="top|center_horizontal" />

        </com.matrixwarez.pt.view.ActionButtonFrame>

        <com.matrixwarez.pt.view.ActionButtonFrame
                android:id="@+id/object_move_left_button"
                android:visibility="gone"
                android:layout_width="100dp"
                android:layout_height="100dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

            <com.matrixwarez.pt.view.ActionButtonView
                    android:id="@+id/object_move_left_action"
                    android:layout_width="5dp"
                    android:layout_height="15dp"
                    android:layout_gravity="end|center_vertical" />

        </com.matrixwarez.pt.view.ActionButtonFrame>

        <com.matrixwarez.pt.view.ActionButtonFrame
                android:id="@+id/object_move_right_button"
                android:visibility="gone"
                android:layout_width="100dp"
                android:layout_height="100dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

            <com.matrixwarez.pt.view.ActionButtonView
                    android:id="@+id/object_move_right_action"
                    android:layout_width="5dp"
                    android:layout_height="15dp"
                    android:layout_gravity="start|center_vertical" />

        </com.matrixwarez.pt.view.ActionButtonFrame>

        <LinearLayout
                android:id="@+id/selected_object_yes_no_container"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/howto_step_background"
                android:padding="5dp"
                android:orientation="horizontal"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

            <com.matrixwarez.pt.view.ActionButtonFrame
                    android:id="@+id/selected_object_yes_button"
                    android:layout_width="40dp"
                    android:layout_height="40dp">

                <com.matrixwarez.pt.view.ActionButtonView
                        android:id="@+id/selected_object_yes_action"
                        android:layout_width="21dp"
                        android:layout_height="15dp"
                        android:layout_gravity="center" />

            </com.matrixwarez.pt.view.ActionButtonFrame>

            <com.matrixwarez.pt.view.ActionButtonFrame
                    android:id="@+id/selected_object_no_button"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                <com.matrixwarez.pt.view.ActionButtonView
                        android:id="@+id/selected_object_no_action"
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:layout_gravity="center" />

            </com.matrixwarez.pt.view.ActionButtonFrame>
        </LinearLayout>

        <androidx.cardview.widget.CardView
                android:id="@+id/menu_container"
                android:visibility="gone"
                android:background="@drawable/shadow_background"
                android:layout_width="500dp"
                android:layout_height="300dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:cardCornerRadius="20dp" />

        <FrameLayout
                android:id="@+id/terminal_container"
                android:visibility="gone"
                android:background="@android:color/transparent"
                android:layout_width="500dp"
                android:layout_height="300dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:cardCornerRadius="20dp" />

        <FrameLayout
                android:id="@+id/options_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

        <ProgressBar
                android:id="@+id/progress_circular"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:indeterminate="true" />

        <androidx.appcompat.widget.LinearLayoutCompat
                android:id="@+id/stream_banner"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:alpha="0"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:background="@drawable/info_banner_background"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:layout_marginTop="60dp">

            <ImageView
                    android:id="@+id/banner_icon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/twitch_icon" />

            <TextView
                    android:id="@+id/banner_text"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginStart="5dp"
                    android:fontFamily="@font/inter_semibold"
                    android:textSize="14dp"
                    android:textColor="#FFF"
                    android:text="Banner text" />

        </androidx.appcompat.widget.LinearLayoutCompat>

        <com.matrixwarez.pt.view.ButtonFrame
                android:id="@+id/export_button"
                android:layout_width="58dp"
                android:layout_height="58dp"
                android:visibility="gone"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

            <ImageView
                    android:id="@+id/export_action"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_export" />

            <FrameLayout
                    android:id="@+id/export_border_view"
                    android:visibility="gone"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:background="@drawable/export_background" />

        </com.matrixwarez.pt.view.ButtonFrame>

        <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="#000"
                android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
                app:popupTheme="@style/ThemeOverlay.AppCompat.Light"
                app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                    android:id="@+id/paint_control_layout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:visibility="gone">

                <FrameLayout
                        android:id="@+id/erase_button_background_outer"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/paint_button_background">

                    <com.matrixwarez.pt.view.ColorPanelTouchTargetView
                            android:id="@+id/erase_button_background"
                            android:layout_width="50dp"
                            android:layout_height="50dp"
                            android:layout_gravity="center">

                        <ImageView
                                android:id="@+id/erase_action_view"
                                android:layout_width="25dp"
                                android:layout_height="25dp"
                                android:layout_gravity="center"
                                android:elevation="5dp"
                                android:src="@drawable/eraser_3" />

                    </com.matrixwarez.pt.view.ColorPanelTouchTargetView>

                </FrameLayout>

                <View
                        android:layout_width="20dp"
                        android:layout_height="0dp" />

                <FrameLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">

                    <com.matrixwarez.pt.view.PaintColorIndicator
                            android:id="@+id/paint_indicator_view_bottom_layer"
                            android:layout_width="40dp"
                            android:layout_height="40dp" />

                    <com.matrixwarez.pt.view.PaintColorIndicator
                            android:id="@+id/paint_indicator_view"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@color/colorAccent"
                            android:layout_marginEnd="20dp" />

                </FrameLayout>

                <ImageButton
                        android:id="@+id/done_button"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/ic_done"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Back"
                        android:padding="0dp"
                        android:layout_gravity="center_vertical"
                        android:layout_marginEnd="20dp" />

            </LinearLayout>

        </androidx.appcompat.widget.Toolbar>

        <com.matrixwarez.pt.view.ColorPaletteView
                android:id="@+id/color_palette_view"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintDimensionRatio="16:1"
                app:layout_constraintTop_toBottomOf="@id/toolbar"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:visibility="gone" />

        <FrameLayout
                android:id="@+id/reload_transparent"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

        <androidx.compose.ui.platform.ComposeView
                android:id="@+id/server_list"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

        <androidx.compose.ui.platform.ComposeView
                android:id="@+id/canvas_menu"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Navigation drawer -->
    <com.google.android.material.navigation.NavigationView
            android:id="@+id/nav_view"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="start"
            app:headerLayout="@layout/header_canvas_menu"
            app:menu="@menu/canavs_menu" />

</androidx.drawerlayout.widget.DrawerLayout>