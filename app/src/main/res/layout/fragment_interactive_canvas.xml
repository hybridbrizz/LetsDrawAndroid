<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/drawer_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

    <!-- Main content -->
    <androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
            xmlns:app="http://schemas.android.com/apk/res-auto"
            android:layout_height="match_parent"
            android:layout_width="match_parent">

        <com.matrixwarez.pt.view.InteractiveCanvasView
                android:id="@+id/surface_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

        <androidx.compose.ui.platform.ComposeView
                android:id="@+id/help_messages"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

        <androidx.compose.ui.platform.ComposeView
                android:id="@+id/client_canvas_locations"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

        <LinearLayout
                android:id="@+id/ll_latency_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginEnd="5dp">

            <TextView
                    android:id="@+id/text_latency"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:layout_marginEnd="10dp"
                    android:fontFamily="@font/inter_regular"
                    android:textColor="#FFFFFF"
                    android:shadowColor="#000000"
                    android:shadowDx="1"
                    android:shadowDy="1"
                    android:shadowRadius="2"
                    android:text="" />

            <ImageView
                    android:id="@+id/image_no_socket"
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:layout_marginTop="21dp"
                    android:src="@drawable/green_circle" />

        </LinearLayout>

        <FrameLayout
                android:id="@+id/paint_warning_frame"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toLeftOf="@id/paint_panel"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:background="@drawable/paint_warning_frame_background" />


        <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/paint_panel"
                android:visibility="invisible"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:orientation="horizontal"
                android:gravity="center"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:background="@drawable/marble_2">

            <TextView
                    android:id="@+id/palette_name_text"
                    android:visibility="invisible"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_light"
                    android:textSize="12pt"
                    android:text="Recent Colors"
                    android:textColor="@android:color/white"
                    android:layout_marginTop="15dp"
                    android:gravity="center"
                    app:layout_constraintTop_toTopOf="parent"
                    android:shadowColor="#7F000000"
                    android:shadowDx="2"
                    android:shadowDy="2"
                    android:shadowRadius="3" />

            <LinearLayout
                    android:id="@+id/color_action_button_menu"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/palette_name_text">

                <FrameLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">

                    <com.matrixwarez.pt.view.ActionButtonFrame
                            android:id="@+id/palette_add_color_button"
                            android:visibility="gone"
                            android:layout_width="40dp"
                            android:layout_height="40dp">

                        <com.matrixwarez.pt.view.ActionButtonView
                                android:id="@+id/palette_add_color_action"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center" />

                    </com.matrixwarez.pt.view.ActionButtonFrame>

                    <com.matrixwarez.pt.view.ActionButtonFrame
                            android:id="@+id/palette_remove_color_button"
                            android:visibility="gone"
                            android:layout_width="40dp"
                            android:layout_height="40dp">

                        <com.matrixwarez.pt.view.ActionButtonView
                                android:id="@+id/palette_remove_color_action"
                                android:layout_width="20dp"
                                android:layout_height="2dp"
                                android:layout_gravity="center" />

                    </com.matrixwarez.pt.view.ActionButtonFrame>

                </FrameLayout>

                <com.matrixwarez.pt.view.ActionButtonFrame
                        android:id="@+id/lock_paint_panel"
                        android:visibility="gone"
                        android:layout_width="40dp"
                        android:layout_height="40dp">

                    <com.matrixwarez.pt.view.ActionButtonView
                            android:id="@+id/lock_paint_panel_action"
                            android:layout_width="18dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center" />

                </com.matrixwarez.pt.view.ActionButtonFrame>

            </LinearLayout>

            <TextView
                    android:id="@+id/drops_amt_text"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:textColor="#CCFFFFFF"
                    android:layout_marginTop="5dp"
                    android:layout_marginBottom="5dp"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:layout_constraintTop_toTopOf="parent" />

            <com.matrixwarez.pt.view.PaintQuantityBar
                    android:id="@+id/paint_qty_bar"
                    android:layout_width="match_parent"
                    android:layout_height="13dp"
                    android:layout_marginTop="30dp"
                    android:layout_marginLeft="40dp"
                    android:layout_marginRight="40dp"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

            <com.matrixwarez.pt.view.PaintQuantityCircle
                    android:id="@+id/paint_qty_circle"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:layout_marginTop="15dp"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

            <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/paint_time_info_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="invisible"
                    android:background="@drawable/timer_text_background"
                    app:layout_constraintTop_toTopOf="@id/paint_qty_circle"
                    app:layout_constraintBottom_toBottomOf="@id/paint_qty_circle"
                    app:layout_constraintLeft_toLeftOf="@id/paint_qty_circle"
                    app:layout_constraintRight_toRightOf="@id/paint_qty_circle">

                <TextView
                        android:id="@+id/paint_time_info"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:visibility="invisible"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:lines="1"
                        android:layout_marginLeft="10dp"
                        android:layout_marginRight="10dp"
                        android:textColor="#FFFFFFFF"
                        android:layout_margin="10dp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintRight_toRightOf="parent" />

                <TextView
                        android:id="@+id/paint_amt_info"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:visibility="invisible"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:lines="1"
                        android:layout_marginLeft="10dp"
                        android:layout_marginRight="10dp"
                        android:textColor="#FFFFFFFF"
                        android:layout_margin="10dp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintRight_toRightOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <View
                    android:id="@+id/top_left_anchor"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_marginTop="0dp"
                    android:layout_marginLeft="30dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintLeft_toLeftOf="parent" />

            <View
                    android:id="@+id/top_right_anchor"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_marginTop="0dp"
                    android:layout_marginRight="30dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintRight_toRightOf="parent" />

            <View
                    android:id="@+id/bottom_left_anchor"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_marginLeft="30dp"
                    android:layout_marginTop="36dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintLeft_toLeftOf="parent" />

            <View
                    android:id="@+id/bottom_right_anchor"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_marginRight="30dp"
                    android:layout_marginTop="36dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintRight_toRightOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <FrameLayout
                android:id="@+id/paint_button_container_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_margin="10dp">

            <FrameLayout
                    android:id="@+id/paint_button_background_outer"
                    android:layout_width="160dp"
                    android:layout_height="160dp"
                    android:layout_gravity="center" />

            <com.matrixwarez.pt.view.ColorPanelTouchTargetView
                    android:id="@+id/paint_button_background"
                    android:layout_width="140dp"
                    android:layout_height="140dp"
                    android:layout_gravity="center" />

            <LinearLayout
                    android:id="@+id/paint_button_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    android:gravity="center_horizontal"
                    android:layout_gravity="center">

                <ImageView
                        android:id="@+id/paint_panel_action_view"
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:layout_gravity="center"
                        android:elevation="5dp"
                        android:src="@drawable/ic_add_bold" />

                <TextView
                        android:id="@+id/text_bottom_display"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_semibold"
                        android:textSize="14sp" />

            </LinearLayout>

        </FrameLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/color_picker_frame"
                android:visibility="invisible"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:background="#FFF">

        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/recent_colors_container"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="40dp"
                android:layout_marginLeft="58dp"
                android:layout_marginRight="58dp"
                android:elevation="10dp"
                app:layout_constraintLeft_toRightOf="@id/color_picker_frame"
                app:layout_constraintBottom_toBottomOf="parent">

